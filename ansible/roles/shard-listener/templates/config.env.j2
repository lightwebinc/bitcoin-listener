# shard-listener environment configuration
# Managed by Ansible — do not edit manually

MULTICAST_IF={{ ingress_iface if ingress_iface is string else ingress_iface[0] }}
LISTEN_PORT={{ listen_port }}
SHARD_BITS={{ shard_bits }}
MC_SCOPE={{ mc_scope }}
MC_GROUP_ID={{ mc_group_id }}
SHARD_INCLUDE={{ shard_include }}
SUBTREE_INCLUDE={{ subtree_include }}
SUBTREE_EXCLUDE={{ subtree_exclude }}
EGRESS_ADDR={{ egress_addr }}
EGRESS_PROTO={{ egress_proto }}
STRIP_HEADER={{ 'true' if strip_header else 'false' }}
RETRY_ENDPOINTS={{ retry_endpoints }}
NACK_JITTER_MAX={{ nack_jitter_max }}
NACK_BACKOFF_MAX={{ nack_backoff_max }}
NACK_MAX_RETRIES={{ nack_max_retries }}
NACK_GAP_TTL={{ nack_gap_ttl }}
BEACON_ENABLED={{ 'true' if beacon_enabled else 'false' }}
BEACON_PORT={{ beacon_port }}
BEACON_SCOPE={{ beacon_scope }}
SUBTREE_GROUPS={{ subtree_groups }}
SUBTREE_GROUP_DEFAULT_TTL={{ subtree_group_default_ttl }}
ANNOUNCE_SCOPE={{ announce_scope }}
SENDER_INCLUDE={{ sender_include }}
SENDER_EXCLUDE={{ sender_exclude }}
NUM_WORKERS={{ num_workers }}
METRICS_ADDR={{ metrics_addr }}
OTLP_ENDPOINT={{ otlp_endpoint }}
OTLP_INTERVAL={{ otlp_interval }}
DRAIN_TIMEOUT={{ drain_timeout }}
INSTANCE_ID={{ instance_id }}
DEBUG={{ 'true' if listener_debug else 'false' }}
VERIFY_PAYLOAD_HASH={{ 'true' if verify_payload_hash else 'false' }}
MC_EGRESS_ENABLED={{ 'true' if mc_egress_enabled else 'false' }}
MC_EGRESS_IFACE={{ mc_egress_iface }}
MC_EGRESS_PORT={{ mc_egress_port }}
MC_EGRESS_SCOPE={{ mc_egress_scope }}
MC_EGRESS_GROUP_ID={{ mc_egress_group_id }}
MC_EGRESS_HOPLIMIT={{ mc_egress_hoplimit }}
DEPLOYMENT_ID={{ deployment_id | default('') }}
NODE_ID={{ node_id | default('') }}
EGRESS_DEDUP_REDIS_ADDR={{ egress_dedup_redis_addr | default('') }}
EGRESS_DEDUP_PREFIX={{ egress_dedup_prefix | default('bsl:egr:') }}
EGRESS_DEDUP_TTL={{ egress_dedup_ttl_redis | default('60s') }}
EGRESS_DEDUP_LOCAL_CAP={{ egress_dedup_local_cap | default(1048576) }}
INGRESS_SET_REDIS_ADDR={{ ingress_set_redis_addr | default('') }}
INGRESS_SET_PREFIX={{ ingress_set_prefix | default('bsp:tx:') }}
INGRESS_SET_TTL={{ ingress_set_ttl | default('10m') }}
INGRESS_SET_LOCAL_CAP={{ ingress_set_local_cap | default(1048576) }}
